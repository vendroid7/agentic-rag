# Copy this file to .env and fill in the values.

# SEC EDGAR rejects unidentified traffic, so it requires an identifying
# "Name email" string on every request. Only needed to run ingestion.
SEC_USER_AGENT="Your Name your.email@example.com"

# Groq API key. Get a free one at https://console.groq.com
# Optional: you can instead paste the key into the sidebar once the UI is running.
GROQ_API_KEY=""
